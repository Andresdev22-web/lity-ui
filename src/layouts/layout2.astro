---
import '../styles/global.css';

import Header1 from '../components/v1/headers/header1.astro';

interface Props {
  title?: string;
}

const { title = "Layout de Prueba UI" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--bg-primary)] text-[var(--text-primary)] transition-colors duration-300 relative">

    <!-- FILA 1: Header -->
    <header class="w-full border-b border-[var(--border-color)] bg-[var(--bg-secondary)] sticky top-0 z-40">
      <Header1 />
    </header>

    <!-- FILA 2: Contenedor Principal en 2 Columnas -->
    <div class="flex-1 flex max-w-7xl w-full mx-auto">
      
      <!-- Columna Izquierda: Navegación Escritorio (Desktop Sidebar) -->
      <aside class="w-64 shrink-0 p-6 border-r border-[var(--border-color)] bg-[var(--bg-secondary)]/40 hidden md:block sticky top-[65px] h-[calc(100vh-65px)] overflow-y-auto">
        <nav class="space-y-6">
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-3">
              En esta página
            </h3>
            <ul class="space-y-1 text-sm">
              <li>
                <a href="#introduccion" class="block py-1.5 px-3 rounded-md hover:bg-[var(--bg-secondary)] hover:text-[var(--accent)] transition-all">
                  Introducción
                </a>
              </li>
              <li>
                <a href="#componentes" class="block py-1.5 px-3 rounded-md hover:bg-[var(--bg-secondary)] hover:text-[var(--accent)] transition-all">
                  Componentes
                </a>
              </li>
              <li>
                <a href="#configuracion" class="block py-1.5 px-3 rounded-md hover:bg-[var(--bg-secondary)] hover:text-[var(--accent)] transition-all">
                  Configuración
                </a>
              </li>
            </ul>
          </div>
        </nav>
      </aside>

      <!-- Columna Derecha: Contenido Principal -->
      <main class="flex-1 p-6 md:p-10 max-w-none overflow-y-auto">
        <slot />
      </main>

    </div>

    <!-- ========================================== -->
    <!-- COMPONENTES PARA NAVEGACIÓN MÓVIL (MOBILE) -->
    <!-- ========================================== -->

    <!-- 1. Botón Flotante (FAB) - Visible solo en pantallas chicas (md:hidden) -->
    <button
      id="open-nav-btn"
      aria-label="Abrir navegación de página"
      class="md:hidden fixed bottom-6 right-6 z-50 flex items-center gap-2 px-4 py-3 rounded-full bg-[var(--accent)] text-white shadow-lg hover:scale-105 active:scale-95 transition-all"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
      </svg>
      <span class="text-sm font-medium">Menú</span>
    </button>

    <!-- 2. Contenedor Drawer Móvil + Overlay -->
    <div id="mobile-nav-container" class="fixed inset-0 z-50 pointer-events-none transition-opacity duration-300 opacity-0 md:hidden">
      
      <!-- Fondo translúcido (Fondo oscuro al abrir) -->
      <div id="mobile-nav-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

      <!-- Drawer Lateral / Panel Desplegable -->
      <aside 
        id="mobile-nav-drawer"
        class="absolute top-0 right-0 w-72 h-full bg-[var(--bg-secondary)] border-l border-[var(--border-color)] p-6 shadow-2xl flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-in-out pointer-events-auto"
      >
        <div>
          <!-- Cabecera del Drawer con Botón de Cierre -->
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-[var(--border-color)]">
            <h3 class="font-bold text-sm uppercase tracking-wider text-[var(--text-secondary)]">
              Navegación
            </h3>
            <button
              id="close-nav-btn"
              aria-label="Cerrar menú"
              class="p-1.5 rounded-lg text-[var(--text-secondary)] hover:bg-[var(--bg-primary)] hover:text-[var(--text-primary)] transition-colors"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <!-- Links de Navegación Móvil -->
          <ul class="space-y-2 text-base">
            <li>
              <a href="#introduccion" class="mobile-nav-link block py-2 px-3 rounded-md hover:bg-[var(--bg-primary)] hover:text-[var(--accent)] transition-all">
                Introducción
              </a>
            </li>
            <li>
              <a href="#componentes" class="mobile-nav-link block py-2 px-3 rounded-md hover:bg-[var(--bg-primary)] hover:text-[var(--accent)] transition-all">
                Componentes
              </a>
            </li>
            <li>
              <a href="#configuracion" class="mobile-nav-link block py-2 px-3 rounded-md hover:bg-[var(--bg-primary)] hover:text-[var(--accent)] transition-all">
                Configuración
              </a>
            </li>
          </ul>
        </div>

        <div class="pt-4 border-t border-[var(--border-color)] text-xs text-[var(--text-secondary)] text-center">
          Desliza o presiona la X para cerrar
        </div>
      </aside>
    </div>

  </body>
</html>

<!-- Lógica interactiva nativa para abrir/cerrar menú -->
<script>
  function setupMobileNav() {
    const openBtn = document.getElementById('open-nav-btn');
    const closeBtn = document.getElementById('close-nav-btn');
    const backdrop = document.getElementById('mobile-nav-backdrop');
    const container = document.getElementById('mobile-nav-container');
    const drawer = document.getElementById('mobile-nav-drawer');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    function openMenu() {
      container?.classList.remove('pointer-events-none', 'opacity-0');
      container?.classList.add('opacity-100');
      drawer?.classList.remove('translate-x-full');
      document.body.style.overflow = 'hidden'; // Evita scroll en la página mientras el menú está abierto
    }

    function closeMenu() {
      container?.classList.remove('opacity-100');
      container?.classList.add('opacity-0', 'pointer-events-none');
      drawer?.classList.add('translate-x-full');
      document.body.style.overflow = ''; // Restaura el scroll
    }

    openBtn?.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);

    // Cerrar el menú automáticamente al hacer clic en cualquiera de los enlaces internos
    mobileLinks.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }

  // Ejecución inicial y compatibilidad con transiciones de Astro (View Transitions)
  setupMobileNav();
  document.addEventListener('astro:after-swap', setupMobileNav);
</script>