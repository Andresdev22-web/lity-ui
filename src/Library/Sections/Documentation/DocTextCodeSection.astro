
---
import { Icon } from "astro-icon/components";

interface CodeBlock {
  title?: string;
  code: string;
  language?: string;
}

interface ContentItem {
  id?: string;
  title: string;
  number?: string | number;
  paragraphs?: string[];
  codeBlocks?: CodeBlock[];
  items?: ContentItem[];
}

interface Props {
  id: string;
  title: string;
  number?: string | number;
  icon?: string;
  description?: string;
  paragraphs?: string[];
  codeBlocks?: CodeBlock[];
  items?: ContentItem[];
}

const {
  id,
  title,
  number,
  icon = "lucide:book-open",
  description,
  paragraphs = [],
  codeBlocks = [],
  items = [],
} = Astro.props;

const headingClasses = [
  "text-xl font-semibold",
  "text-lg font-semibold",
];

function slugify(value: string) {
  return value
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}
---

<section id={id} class="mb-16 scroll-mt-8">
  <div class="mb-4 flex items-center gap-3">
    <Icon name={icon} class="h-6 w-6 shrink-0 text-[var(--accent)]" />
    <h2 class="text-2xl font-bold text-[var(--text-primary)]">
      {number != null && `${number}. `}{title}
    </h2>
  </div>

  {description && (
    <p class="mb-5 leading-7 text-[var(--text-secondary)]">
      {description}
    </p>
  )}

  {paragraphs.length > 0 && (
    <div class="mb-5 space-y-3">
      {paragraphs.map((paragraph) => (
        <p class="leading-7 text-[var(--text-secondary)]">{paragraph}</p>
      ))}
    </div>
  )}

  {codeBlocks.length > 0 && (
    <div class="mb-6 space-y-4">
      {codeBlocks.map((block) => (
        <div>
          {block.title && (
            <h3 class="mb-2 text-sm font-semibold text-[var(--text-primary)]">
              {block.title}
            </h3>
          )}
          <div class="overflow-x-auto rounded-lg border border-[var(--border-color)] bg-[var(--bg-secondary)] p-4">
            <pre class="text-sm leading-6 text-[var(--text-secondary)]"><code>{block.code}</code></pre>
          </div>
        </div>
      ))}
    </div>
  )}

  {items.length > 0 && (
    <div class="space-y-7">
      {items.map((item, index) => (
        <div
          id={item.id ?? `${id}-${slugify(item.title)}`}
          class="scroll-mt-8"
        >
          <h3 class:list={[headingClasses[0], "mb-3 text-[var(--text-primary)]"]}>
            {item.number != null && `${item.number}. `}
            {item.title}
          </h3>

          {item.paragraphs?.length ? (
            <div class="mb-4 space-y-3">
              {item.paragraphs.map((paragraph) => (
                <p class="leading-7 text-[var(--text-secondary)]">{paragraph}</p>
              ))}
            </div>
          ) : null}

          {item.codeBlocks?.length ? (
            <div class="mb-5 space-y-4">
              {item.codeBlocks.map((block) => (
                <div>
                  {block.title && (
                    <h4 class="mb-2 text-sm font-semibold text-[var(--text-primary)]">
                      {block.title}
                    </h4>
                  )}
                  <div class="overflow-x-auto rounded-lg border border-[var(--border-color)] bg-[var(--bg-secondary)] p-4">
                    <pre class="text-sm leading-6 text-[var(--text-secondary)]"><code>{block.code}</code></pre>
                  </div>
                </div>
              ))}
            </div>
          ) : null}

          {item.items?.length ? (
            <div class="ml-4 space-y-5 border-l border-[var(--border-color)] pl-4">
              {item.items.map((subitem) => (
                <div
                  id={subitem.id ?? `${id}-${slugify(item.title)}-${slugify(subitem.title)}`}
                  class="scroll-mt-8"
                >
                  <h4 class:list={[headingClasses[1], "mb-3 text-[var(--text-primary)]"]}>
                    {subitem.number != null && `${subitem.number}. `}
                    {subitem.title}
                  </h4>

                  {subitem.paragraphs?.length ? (
                    <div class="mb-4 space-y-3">
                      {subitem.paragraphs.map((paragraph) => (
                        <p class="leading-7 text-[var(--text-secondary)]">{paragraph}</p>
                      ))}
                    </div>
                  ) : null}

                  {subitem.codeBlocks?.length ? (
                    <div class="space-y-4">
                      {subitem.codeBlocks.map((block) => (
                        <div>
                          {block.title && (
                            <h5 class="mb-2 text-sm font-semibold text-[var(--text-primary)]">
                              {block.title}
                            </h5>
                          )}
                          <div class="overflow-x-auto rounded-lg border border-[var(--border-color)] bg-[var(--bg-secondary)] p-4">
                            <pre class="text-sm leading-6 text-[var(--text-secondary)]"><code>{block.code}</code></pre>
                          </div>
                        </div>
                      ))}
                    </div>
                  ) : null}
                </div>
              ))}
            </div>
          ) : null}
        </div>
      ))}
    </div>
  )}
</section>

<!--
DocTextCodeSection.astro
------------------------
Propiedades:
- id: identificador de la sección.
- title: título principal.
- number: numeración opcional.
- icon: icono Lucide del encabezado.
- description: descripción introductoria.
- paragraphs: párrafos adicionales.
- codeBlocks: bloques de código.
- items: subtítulos con contenido y sub-subtítulos.

Uso:
Componente para documentar conceptos, configuraciones y comandos
con una jerarquía de títulos clara.
-->
