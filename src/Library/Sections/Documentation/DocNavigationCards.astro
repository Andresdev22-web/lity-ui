---
import { Icon } from "astro-icon/components";

interface NavigationItem {
  href: string;
  label: string;
  icon: string;
  description?: string;
}

interface Props {
  title?: string;
  items: NavigationItem[];
}

const {
  title = "En esta guía",
  items,
} = Astro.props;
---

<nav
  class="mb-12"
  aria-label="Contenido de la documentación"
>
  <h2 class="mb-4 text-lg font-semibold text-[var(--text-primary)]">
    {title}
  </h2>

  <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          class="group flex h-full items-center gap-3 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/50 p-4 transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--accent)]/50 hover:bg-[var(--bg-secondary)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
        >
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-[var(--border-color)] bg-[var(--bg-secondary)] text-[var(--accent)] transition-colors group-hover:border-[var(--accent)]/30 group-hover:bg-[var(--accent)]/10">
            <Icon name={item.icon} class="h-5 w-5" />
          </span>

          <span class="min-w-0 flex-1">
            <span class="block text-sm font-semibold text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent)]">
              {item.label}
            </span>

            {item.description && (
              <span class="mt-1 block text-xs leading-relaxed text-[var(--text-secondary)]">
                {item.description}
              </span>
            )}
          </span>

          <Icon
            name="lucide:arrow-up-right"
            class="h-4 w-4 shrink-0 text-[var(--text-secondary)] transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-[var(--accent)]"
          />
        </a>
      </li>
    ))}
  </ul>
</nav>

<!--
DocNavigationCards.astro
------------------------
Propiedades:
- title: título opcional del índice.
- items: lista de enlaces con href, label, icon y description opcional.

Uso:
Muestra un índice visual para navegar entre secciones de una página.
Cada href debe apuntar al id de una sección existente.
-->
