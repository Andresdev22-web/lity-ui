</DocAlert>

<DocAlert type="success" title="Instalación completada">
  Ya puedes comenzar a utilizar los componentes.
</DocAlert>

<DocAlert
  type="error"
  title="No olvides este paso"
  icon="lucide:shield-alert"
>
  Configura las variables de entorno antes de desplegar tu aplicación.
</DocAlert>
