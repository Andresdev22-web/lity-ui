
---
import { Icon } from "astro-icon/components";

interface GridItem {
  icon?: string;
  title: string;
  description?: string;
  href?: string;
}

interface Props {
  icon?: string;
  title?: string;
  paragraphs?: string[];
  items: GridItem[];
  columns?: 1 | 2 | 3 | 4;
}

const {
  icon,
  title,
  paragraphs = [],
  items,
  columns = 2,
} = Astro.props as Props;

const columnClasses: Record<NonNullable<Props["columns"]>, string> = {
  1: "grid-cols-1",
  2: "grid-cols-1 sm:grid-cols-2",
  3: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3",
  4: "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4",
};

const gridClass = columnClasses[columns];
---

<section class="mb-16">
  {(icon || title || paragraphs.length > 0) && (
    <div class="mb-6">
      {(icon || title) && (
        <div class="mb-4 flex items-center gap-3">
          {icon && (
            <Icon
              name={icon}
              class="h-6 w-6 shrink-0 text-[var(--accent)]"
            />
          )}

          {title && (
            <h2 class="text-2xl font-bold text-[var(--text-primary)]">
              {title}
            </h2>
          )}
        </div>
      )}

      {paragraphs.length > 0 && (
        <div class="space-y-4 leading-7 text-[var(--text-secondary)]">
          {paragraphs.map((paragraph: string) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )}
    </div>
  )}

  <div class={`grid gap-5 ${gridClass}`}>
    {items.map((item: GridItem) => (
      <article class="rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)] p-5">
        {item.icon && (
          <Icon
            name={item.icon}
            class="mb-3 h-6 w-6 text-[var(--accent)]"
          />
        )}

        <h3 class="mb-2 text-lg font-semibold text-[var(--text-primary)]">
          {item.title}
        </h3>

        {item.description && (
          <p class="leading-7 text-[var(--text-secondary)]">
            {item.description}
          </p>
        )}
      </article>
    ))}
  </div>
</section>

<!--
DOCUMENTACIÓN DEL COMPONENTE: DocGrid

Descripción:
  Muestra una cuadrícula de tarjetas con título, icono y párrafos
  introductorios opcionales.

Props:
  icon      (string, opcional): Icono junto al título principal.
  title     (string, opcional): Título de la sección.
  paragraphs (string[], opcional): Párrafos introductorios.
  items     (GridItem[], obligatorio): Elementos de la cuadrícula.
  columns   (1 | 2 | 3 | 4, opcional): Número de columnas.
            Predeterminado: 2.

Cada elemento de items admite:
  icon        (string, opcional): Icono de la tarjeta.
  title       (string, obligatorio): Título de la tarjeta.
  description (string, opcional): Descripción de la tarjeta.
  href        (string, opcional): Reservado para un posible enlace.

Ejemplo de uso:

<DocGrid
  icon="lucide:sparkles"
  title="Características principales"
  paragraphs={[
    "Lity UI incluye herramientas para facilitar el desarrollo.",
    "Estas son algunas de sus características principales.",
  ]}
  columns={3}
  items={[
    {
      icon: "lucide:zap",
      title: "Rápido",
      description: "Acelera el desarrollo de tus páginas.",
    },
    {
      icon: "lucide:layers",
      title: "Modular",
      description: "Organiza tu interfaz con componentes reutilizables.",
    },
    {
      icon: "lucide:palette",
      title: "Personalizable",
      description: "Adapta los estilos a tu proyecto.",
    },
  ]}
/>
-->
