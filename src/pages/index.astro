---
import Layout from '../layouts/v2/LandingPage/Layout.astro';
import Header from '../components/v2/LandingPage/header/Header.astro';

const titlePage: string = "Lity Ui";

---

<Layout titlePage={titlePage}>
   <Header
  title={titlePage} 
    showThemeSelector={true} 
  
/>
<!-- HERO & SOBRE LITY UI -->
  <section class="relative overflow-hidden py-20 px-6 md:px-12 max-w-7xl mx-auto border-b border-[var(--border-color)]">
    
    <!-- Decoración de Fondo (Glow Effect) -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-[var(--accent)]/10 rounded-full blur-3xl -z-10 pointer-events-none"></div>

    <div class="max-w-3xl mx-auto text-center space-y-6">
      
      <!-- Badge Superior -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--accent)]/10 border border-[var(--accent)]/20 text-xs font-semibold text-[var(--accent)]">
        <span class="w-2 h-2 rounded-full bg-[var(--accent)] animate-pulse"></span>
        Librería de Componentes para Astro & Tailwind
      </div>

      <!-- Título Principal -->
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-[var(--text-primary)]">
        Construye sitios web <span class="text-transparent bg-clip-text bg-gradient-to-r from-[var(--accent)] to-purple-400">ultrarrápidos</span> y modernos.
      </h1>

      <!-- Subtítulo / Qué es Lity UI -->
      <p class="text-lg sm:text-xl text-[var(--text-secondary)] leading-relaxed">
        <strong>Lity UI</strong> es un kit de UI ligero y accesible creado para desarrolladores que buscan acelerar la creación de Landing Pages persuasivas y sistemas de documentación sin perder el control sobre el diseño.
      </p>

      <!-- Botones de Acción (Call to Action) -->
      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        
        <!-- Botón a la Documentación -->
        <a 
          href="/documentation" 
          class="flex items-center gap-2 px-6 py-3 rounded-xl bg-[var(--accent)] text-white font-semibold shadow-lg shadow-[var(--accent)]/25 hover:opacity-90 hover:scale-[1.02] active:scale-[0.98] transition-all"
        >
          <span>Ir a la Documentación</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <!-- Botón Ver en GitHub -->
        <a 
          href="https://github.com/Andresdev22-web/lity-ui" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-6 py-3 rounded-xl bg-[var(--bg-secondary)] text-[var(--text-primary)] border border-[var(--border-color)] font-medium hover:bg-[var(--border-color)]/30 transition-all"
        >
          <span>GitHub</span>
        </a>
      </div>

    </div>

    <!-- SECCIÓN: ¿CÓMO NACIÓ LITY UI? -->
    <div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="p-6 rounded-2xl bg-[var(--bg-secondary)]/40 border border-[var(--border-color)] space-y-2">
        <div class="text-2xl mb-2">💡</div>
        <h3 class="text-lg font-bold">El Origen</h3>
        <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
          Nació de la necesidad de unificar componentes reutilizables en un solo lugar, evitando rehacer estructuras comunes de interfaz en cada proyecto web.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-[var(--bg-secondary)]/40 border border-[var(--border-color)] space-y-2">
        <div class="text-2xl mb-2">⚡</div>
        <h3 class="text-lg font-bold">Rendimiento Cero-JS</h3>
        <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
          Diseñado sobre la arquitectura de islas de Astro y Tailwind CSS v4 para entregar el menor footprint de JavaScript al navegador.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-[var(--bg-secondary)]/40 border border-[var(--border-color)] space-y-2">
        <div class="text-2xl mb-2">🎨</div>
        <h3 class="text-lg font-bold">Ecosistema Cohesivo</h3>
        <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
          Pensado con variables CSS semánticas para integrarse de forma fluida tanto en layouts promocionales como en documentaciones de producto.
        </p>
      </div>

    </div>
  </section>
</Layout>

