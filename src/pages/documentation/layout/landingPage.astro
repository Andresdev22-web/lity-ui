---

import Layout from "../../../layouts/layoutDocumentacion.astro";

const titlePage: string = "Documentacion"

---

<Layout titlePage={titlePage}>
<!-- SECCIÓN: DOCUMENTACIÓN DEL LAYOUT DE LANDING PAGE -->
<!-- SECCIÓN: DOCUMENTACIÓN DEL LAYOUT DE LANDING PAGE -->
  <section id="landing-layout-doc" class="mb-16 border-t border-[var(--border-color)] pt-12">
    <!-- Badge & Título Principal -->
    <div class="flex items-center gap-3 mb-4">
      <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-[var(--accent)]/15 text-[var(--accent)] border border-[var(--accent)]/30">
        Layout Principal
      </span>
      <h2 class="text-3xl font-bold">Landing Page Layout</h2>
    </div>

    <!-- Descripción General -->
    <p class="text-lg text-[var(--text-secondary)] mb-8 leading-relaxed">
      El <code class="px-1.5 py-0.5 rounded bg-[var(--bg-secondary)] border border-[var(--border-color)] text-sm">LandingLayout</code> es una plantilla minimalista y ligera diseñada para páginas promocionales o de inicio. Inyecta automáticamente los estilos globales de la librería y provee un lienzo limpio a pantalla completa para renderizar componentes como héroes, grillas de características y pies de página.
    </p>

    <!-- Props & Parámetros -->
    <div class="mb-8">
      <h3 class="text-xl font-bold mb-4">Props y Parámetros</h3>
      
      <!-- Tabla de Props -->
      <div class="overflow-x-auto border border-[var(--border-color)] rounded-lg">
        <table class="w-full text-left text-sm">
          <thead class="bg-[var(--bg-secondary)] border-b border-[var(--border-color)] text-[var(--text-primary)]">
            <tr>
              <th class="p-3 font-semibold">Prop</th>
              <th class="p-3 font-semibold">Tipo</th>
              <th class="p-3 font-semibold">Por Defecto</th>
              <th class="p-3 font-semibold">Descripción</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--border-color)] text-[var(--text-secondary)]">
            <tr>
              <td class="p-3 font-mono text-[var(--accent)]">titlePage</td>
              <td class="p-3 font-mono">string</td>
              <td class="p-3 font-mono">'Sin titulo'</td>
              <td>Asigna el título que se mostrará en la pestaña del navegador (<code class="text-xs">&lt;title&gt;</code>).</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Slots Disponibles -->
    <div class="mb-8">
      <h3 class="text-xl font-bold mb-3">Slots Disponibles</h3>
      <div class="p-4 rounded-lg bg-[var(--bg-secondary)]/50 border border-[var(--border-color)]">
        <div class="font-mono text-sm font-semibold text-[var(--accent)] mb-1">&lt;slot /&gt; (Default)</div>
        <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
          Slot principal por defecto donde se renderiza todo el contenido HTML o las secciones de tu aplicación.
        </p>
      </div>
    </div>

    <!-- Ejemplo de Uso -->
    <div>
      <h3 class="text-xl font-bold mb-3">Ejemplo de Uso</h3>
      <div class="bg-[var(--bg-secondary)] p-4 rounded-lg border border-[var(--border-color)] font-mono text-xs overflow-x-auto">
        <pre class="text-[var(--text-primary)]"><code>{"---\nimport { LandingLayout, Header } from 'lity-ui';\n---\n\n<LandingLayout titlePage=\"Lity UI - Bienvenido\">\n  <Header title=\"Mi Producto\" floating={true} />\n  \n  <main class=\"max-w-6xl mx-auto px-4 py-12\">\n    <h1>Construye Landing Pages a alta velocidad</h1>\n  </main>\n</LandingLayout>"}</code></pre>
      </div>
    </div>
  </section>
</Layout>