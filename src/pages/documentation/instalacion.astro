---
import Layout from "../../layouts/layoutDocumentacion.astro";

const titlePage: string = "Documentacion";
---

<Layout titlePage={titlePage}>
  <!-- SECCIÓN: INSTALACIÓN Y CONFIGURACIÓN -->
  <section id="instalacion" class="mb-16 border-t border-[var(--border-color)] pt-12">
    <!-- Badge & Título Principal -->
    <div class="flex items-center gap-3 mb-4">
      <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-[var(--accent)]/15 text-[var(--accent)] border border-[var(--accent)]/30">
        Guía de Inicio
      </span>
      <h2 class="text-3xl font-bold">Instalación y Configuración</h2>
    </div>

    <p class="text-lg text-[var(--text-secondary)] mb-8 leading-relaxed">
      <strong>Lity UI</strong> es una librería de componentes reusables construida con Astro, Tailwind CSS v4 y TypeScript. Sigue estos pasos para integrarla correctamente en tu proyecto.
    </p>

    <!-- Paso 1: Instalación de la librería -->
    <div class="mb-10">
      <h3 class="text-xl font-bold mb-3 flex items-center gap-2">
        <span class="text-[var(--accent)]">1.</span> Instalar la librería Lity UI
      </h3>
      <p class="text-sm text-[var(--text-secondary)] mb-3">
        Selecciona tu gestor de paquetes e instala directamente desde GitHub:
      </p>
      
      <!-- Selector de comandos para Paso 1 -->
      <div class="code-package-tabs border border-[var(--border-color)] bg-[var(--bg-secondary)] rounded-xl overflow-hidden my-4"
        data-npm="npm install github:Andresdev22-web/lity-ui"
        data-pnpm="pnpm add github:Andresdev22-web/lity-ui"
        data-yarn="yarn add github:Andresdev22-web/lity-ui"
        data-bun="bun add github:Andresdev22-web/lity-ui"
      >
        <div class="flex items-center justify-between border-b border-[var(--border-color)] px-3 py-2 bg-[var(--bg-primary)]/50">
          <div class="flex items-center gap-1 tab-buttons">
            <button data-pm="npm" class="tab-btn active text-xs font-mono px-2.5 py-1 rounded-md text-[var(--accent)] bg-[var(--accent)]/15 border border-[var(--accent)]/30 font-semibold transition-all">npm</button>
            <button data-pm="pnpm" class="tab-btn text-xs font-mono px-2.5 py-1 rounded-md text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all">pnpm</button>
            <button data-pm="yarn" class="tab-btn text-xs font-mono px-2.5 py-1 rounded-md text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all">yarn</button>
            <button data-pm="bun" class="tab-btn text-xs font-mono px-2.5 py-1 rounded-md text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all">bun</button>
          </div>

          <button class="copy-btn flex items-center gap-1.5 text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] bg-[var(--bg-secondary)] px-2.5 py-1 rounded-md border border-[var(--border-color)] transition-all">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            <span class="copy-text">Copiar</span>
          </button>
        </div>

        <div class="p-4 font-mono text-xs overflow-x-auto text-[var(--text-primary)]">
          <pre><code class="command-display">npm install github:Andresdev22-web/lity-ui</code></pre>
        </div>
      </div>
    </div>

    <!-- Paso 2: Requisitos y Dependencias -->
    <div class="mb-10">
      <h3 class="text-xl font-bold mb-3 flex items-center gap-2">
        <span class="text-[var(--accent)]">2.</span> Instalar Dependencias (Tailwind v4 & Iconos)
      </h3>
      <p class="text-sm text-[var(--text-secondary)] mb-3">
        Instala Tailwind CSS v4, el plugin de Vite y la colección de iconos de Lucide:
      </p>

      <!-- Selector de comandos para Paso 2 -->
      <div class="code-package-tabs border border-[var(--border-color)] bg-[var(--bg-secondary)] rounded-xl overflow-hidden my-4"
        data-npm="npm install tailwindcss @tailwindcss/vite astro-icon @iconify-json/lucide"
        data-pnpm="pnpm add tailwindcss @tailwindcss/vite astro-icon @iconify-json/lucide"
        data-yarn="yarn add tailwindcss @tailwindcss/vite astro-icon @iconify-json/lucide"
        data-bun="bun add tailwindcss @tailwindcss/vite astro-icon @iconify-json/lucide"
      >
        <div class="flex items-center justify-between border-b border-[var(--border-color)] px-3 py-2 bg-[var(--bg-primary)]/50">
          <div class="flex items-center gap-1 tab-buttons">
            <button data-pm="npm" class="tab-btn active text-xs font-mono px-2.5 py-1 rounded-md text-[var(--accent)] bg-[var(--accent)]/15 border border-[var(--accent)]/30 font-semibold transition-all">npm</button>
            <button data-pm="pnpm" class="tab-btn text-xs font-mono px-2.5 py-1 rounded-md text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all">pnpm</button>
            <button data-pm="yarn" class="tab-btn text-xs font-mono px-2.5 py-1 rounded-md text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all">yarn</button>
            <button data-pm="bun" class="tab-btn text-xs font-mono px-2.5 py-1 rounded-md text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all">bun</button>
          </div>

          <button class="copy-btn flex items-center gap-1.5 text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] bg-[var(--bg-secondary)] px-2.5 py-1 rounded-md border border-[var(--border-color)] transition-all">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            <span class="copy-text">Copiar</span>
          </button>
        </div>

        <div class="p-4 font-mono text-xs overflow-x-auto text-[var(--text-primary)]">
          <pre><code class="command-display">npm install tailwindcss @tailwindcss/vite astro-icon @iconify-json/lucide</code></pre>
        </div>
      </div>
    </div>

    <!-- Paso 3: Configuración de astro.config.mjs -->
    <div class="mb-10">
      <h3 class="text-xl font-bold mb-3 flex items-center gap-2">
        <span class="text-[var(--accent)]">3.</span> Configurar astro.config.mjs
      </h3>
      <p class="text-sm text-[var(--text-secondary)] mb-3">
        Añade las integraciones necesarias en el archivo de configuración global de Astro:
      </p>

      <div class="bg-[var(--bg-secondary)] p-4 rounded-lg border border-[var(--border-color)] font-mono text-xs overflow-x-auto">
        <pre class="text-[var(--text-primary)]"><code>{"import { defineConfig } from 'astro/config';\nimport tailwindcss from '@tailwindcss/vite';\nimport icon from 'astro-icon';\n\nexport default defineConfig({\n  integrations: [\n    icon() // Permite renderizar iconos SVG\n  ],\n  vite: {\n    plugins: [tailwindcss()], // Soporte para Tailwind CSS v4\n  },\n});"}</code></pre>
      </div>
    </div>

    <!-- Paso 4: Importación y Uso -->
    <div class="mb-10">
      <h3 class="text-xl font-bold mb-3 flex items-center gap-2">
        <span class="text-[var(--accent)]">4.</span> Importar y Usar Componentes
      </h3>
      <p class="text-sm text-[var(--text-secondary)] mb-3">
        Puedes importar componentes directamente desde el punto de entrada centralizado de <code class="px-1.5 py-0.5 rounded bg-[var(--bg-secondary)] border border-[var(--border-color)] text-xs text-[var(--accent)]">'lity-ui'</code>:
      </p>

      <div class="bg-[var(--bg-secondary)] p-4 rounded-lg border border-[var(--border-color)] font-mono text-xs overflow-x-auto mb-4">
        <pre class="text-[var(--text-primary)]"><code>{"---\nimport Layout from '../layouts/Layout.astro';\nimport { HelloWorld, Button, Card } from 'lity-ui';\n---\n\n<Layout title=\"Página Principal - Lity UI\">\n  <main class=\"min-h-screen flex items-center justify-center\">\n    <HelloWorld title=\"¡Bienvenido a mi web creada con Lity UI!\" />\n  </main>\n</Layout>"}</code></pre>
      </div>

      <div class="p-4 rounded-lg bg-[var(--bg-secondary)]/60 border border-[var(--border-color)]">
        <div class="font-bold text-xs uppercase tracking-wider text-[var(--accent)] mb-1">💡 Nota sobre las importaciones</div>
        <p class="text-xs text-[var(--text-secondary)]">
          No necesitas buscar rutas internas de archivos. Todos los componentes exportados están disponibles en la raíz de la librería.
        </p>
      </div>
    </div>
  </section>
</Layout>

<!-- Script ejecutable en el navegador para controlar las pestañas y la copia -->
<script>
  function setupPackageTabs() {
    const containers = document.querySelectorAll('.code-package-tabs');

    containers.forEach((container) => {
      const buttons = container.querySelectorAll('.tab-btn');
      const display = container.querySelector('.command-display');
      const copyBtn = container.querySelector('.copy-btn');
      const copyText = container.querySelector('.copy-text');

      // Leer los comandos guardados en los atributos data-
      const cmds: Record<string, string> = {
        npm: (container as HTMLElement).dataset.npm || '',
        pnpm: (container as HTMLElement).dataset.pnpm || '',
        yarn: (container as HTMLElement).dataset.yarn || '',
        bun: (container as HTMLElement).dataset.bun || ''
      };

      // Manejar el cambio de pestañas
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const pm = (btn as HTMLElement).dataset.pm || 'npm';

          // Estilos visuales de la pestaña activa
          buttons.forEach((b) => {
            b.classList.remove('active', 'text-[var(--accent)]', 'bg-[var(--accent)]/15', 'border', 'border-[var(--accent)]/30', 'font-semibold');
            b.classList.add('text-[var(--text-secondary)]');
          });

          btn.classList.remove('text-[var(--text-secondary)]');
          btn.classList.add('active', 'text-[var(--accent)]', 'bg-[var(--accent)]/15', 'border', 'border-[var(--accent)]/30', 'font-semibold');

          // Actualizar texto del código
          if (display && cmds[pm]) {
            display.textContent = cmds[pm];
          }
        });
      });

      // Manejar el botón de copiar
      copyBtn?.addEventListener('click', async () => {
        if (display?.textContent) {
          await navigator.clipboard.writeText(display.textContent);
          if (copyText) copyText.textContent = '¡Copiado!';
          setTimeout(() => {
            if (copyText) copyText.textContent = 'Copiar';
          }, 2000);
        }
      });
    });
  }

  // Ejecutar al cargar la página y en re-navegaciones con ViewTransitions de Astro
  setupPackageTabs();
  document.addEventListener('astro:page-load', setupPackageTabs);
</script>