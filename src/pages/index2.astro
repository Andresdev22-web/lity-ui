---
import TestLayout from '../layouts/layout2.astro';
import { HelloWorld } from '../index';
---

<TestLayout title="Prueba de Componentes">
  <section id="introduccion" class="mb-12">
    <h1 class="text-3xl font-bold mb-4">Página de Prueba</h1>
    <p class="text-[var(--text-secondary)] mb-6">
      Esta es una prueba de layout con menú lateral y header integrado.
    </p>
    <HelloWorld />
  </section>

  <section id="componentes" class="mb-12">
    <h2 class="text-2xl font-semibold mb-4">Sección de Componentes</h2>
    <div class="p-6 rounded-lg bg-[var(--bg-secondary)] border border-[var(--border-color)]">
      Contenido dentro de una tarjeta con temas dinámicos.
    </div>
  </section>
</TestLayout>