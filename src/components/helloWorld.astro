---
import { Icon } from 'astro-icon/components';

export interface Props {
  title?: string;
}

const { title = "¡Hola Mundo!" } = Astro.props;
---

<div class="w-full h-screen bg-green-300 flex justify-center items-center">
  <div class="flex items-center gap-6">
    <Icon name="lucide:rocket" class="size-24 text-black" />
    <h1 class="text-9xl font-bold"> 
      {title}
    </h1>
  </div>
</div>