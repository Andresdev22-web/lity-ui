---
import { Icon } from 'astro-icon/components';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

// Lista de temas disponibles (puedes agregar más aquí)
const themes = [
  { id: 'dark', label: 'Dark', icon: 'lucide:moon', color: 'bg-[#090d16]' },
  { id: 'light', label: 'Light', icon: 'lucide:sun', color: 'bg-white' },
  { id: 'pink', label: 'Pink', icon: 'lucide:sparkles', color: 'bg-[#ec4899]' },
  { id: 'blue', label: 'Blue', icon: 'lucide:palette', color: 'bg-[#06b6d4]' },
];
---

<div class:list={['fixed bottom-6 right-6 z-50 relative-container', className]}>
  <!-- Menú desplegable de temas -->
  <div
    id="theme-menu"
    class="hidden absolute bottom-14 right-0 mb-2 p-2 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)] shadow-2xl min-w-[140px] flex-col gap-1 transition-all duration-200"
  >
    {
      themes.map((t) => (
        <button
          data-theme-select={t.id}
          type="button"
          class="flex items-center gap-3 w-full px-3 py-2 text-sm rounded-xl hover:bg-[var(--bg-primary)] transition-colors text-[var(--text-primary)] cursor-pointer"
        >
          <span class:list={['w-3 h-3 rounded-full border border-black/20', t.color]} />
          <span>{t.label}</span>
        </button>
      ))
    }
  </div>

  <!-- Botón Principal Flotante -->
  <button
    id="theme-toggle-btn"
    type="button"
    aria-label="Cambiar tema de la página"
    class="flex items-center justify-center w-12 h-12 rounded-full bg-[var(--bg-secondary)] text-[var(--text-primary)] border border-[var(--border-color)] shadow-xl hover:scale-105 active:scale-95 transition-all duration-300 cursor-pointer"
  >
    <Icon name="lucide:palette" class="w-6 h-6" />
  </button>
</div>

<script>
  const initThemeSelector = () => {
    const toggleBtn = document.getElementById('theme-toggle-btn');
    const menu = document.getElementById('theme-menu');
    const themeOptions = document.querySelectorAll('[data-theme-select]');

    if (!toggleBtn || !menu) return;

    // Mostrar/ocultar menú de temas
    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.toggle('hidden');
      menu.classList.toggle('flex');
    });

    // Ocultar menú al hacer clic afuera
    document.addEventListener('click', () => {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
    });

    // Cambiar tema
    themeOptions.forEach((option) => {
      option.addEventListener('click', () => {
        const selectedTheme = option.getAttribute('data-theme-select');
        if (selectedTheme) {
          document.documentElement.setAttribute('data-theme', selectedTheme);
          localStorage.setItem('theme', selectedTheme);
        }
      });
    });
  };

  initThemeSelector();
  document.addEventListener('astro:after-swap', initThemeSelector);
</script>


<script is:inline>
    const savedTheme = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', savedTheme);
  </script>